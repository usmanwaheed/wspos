{
  "name": "garment-pos",
  "version": "1.0.0",
  "description": "Offline garment shop POS built with Electron, React, TailwindCSS, and SQLite",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "lint": "echo 'No linting configured'",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "electron-store": "^8.1.0",
    "jsbarcode": "^3.11.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^5.1.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.wspos.app",
    "productName": "Garment POS",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "database/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
